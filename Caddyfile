ican.product-sid.us {
    root * /srv/sites/ican

    handle /cermindiri/api/* {
        uri strip_prefix /cermindiri/api
        reverse_proxy host.docker.internal:3042
    }

    handle /cermindiri/bpd/* {
        root * /srv/sites/ican
        try_files {path} /cermindiri/bpd/index.html
        file_server
    }

    handle /cermindiri/general/* {
        root * /srv/sites/ican
        try_files {path} /cermindiri/general/index.html
        file_server
    }

    handle /cermindiri/* {
        root * /srv/sites/ican
        try_files {path} /cermindiri/index.html
        file_server
    }

    handle /trip/api/* {
        uri strip_prefix /trip/api
        reverse_proxy host.docker.internal:3041
    }

    handle {
        file_server
        try_files {path} {path}/index.html
    }
}

